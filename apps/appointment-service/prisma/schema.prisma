generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. UPDATE THIS MODEL
model Appointment {
  id          Int      @id @default(autoincrement())
  patientId   Int
  doctorId    Int
  startTime   DateTime
  endTime     DateTime
  reason      String
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  
  // 🔗 Relations
  patient   User @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor    User @relation("DoctorAppointments", fields: [doctorId], references: [id])

  // ADD THIS LINE:
  prescription Prescription? 
}

// 👻 THE GHOST MODEL (Minimal copy of User)
// We only include fields we need to display in the Appointment Card
model User {
  id    Int     @id 
  name  String?
  email String 
  
  // We need these relations just to satisfy Prisma, even if we don't use them directly
  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorAppointments  Appointment[] @relation("DoctorAppointments")

  // 👻 GHOST DOCTOR PROFILE (Minimal copy)
  doctorProfile DoctorProfile?
}

// 👻 GHOST DOCTOR PROFILE
model DoctorProfile {
  id             Int    @id 
  userId         Int    @unique
  specialization String
  user           User   @relation(fields: [userId], references: [id])
}

// 2. ADD THESE NEW MODELS
model Prescription {
  id            Int      @id @default(autoincrement())
  appointmentId Int      @unique // One prescription per appointment
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  
  diagnosis     String
  remarks       String?  // Doctor's final note
  medicines     PrescriptionItem[]
  createdAt     DateTime @default(now())
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  
  name           String       // Medicine Name
  quantity       String       // e.g., "10 tablets"
  instructions   String       // e.g., "After food, 1-0-1"
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}